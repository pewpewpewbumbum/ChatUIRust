{
  "name": "chatui-deepseek",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run clean && npm install && rollup -c && lessc src/styles/index.less public/index.css && cp src/index.html public/",
    "build:umd": "BABEL_ENV=umd rollup -c",
    "build:css": "lessc src/styles/index.less dist/index.css",
    "start": "serve public",
    "clean": "rm -rf public && mkdir -p public"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "serve": "^14.2.1"
  },
  "devDependencies": {
    "@testing-library/react": "^13.4.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "less": "^4.1.3",
    "rollup": "^2.79.1",
    "typescript": "^4.8.4"
  }
}
